# Copy to .env.local for local development, and add the same two variables in Netlify (or Vercel).
# Find both in the Supabase dashboard under Project Settings -> API.
# They are meant for the browser (your data is protected by Row Level Security), but real values are not committed here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
