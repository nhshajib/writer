{
  "name": "typewit-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:word-format": "node --experimental-transform-types --no-warnings scripts/check-editor-word.mjs",
    "test:e2e": "NEXT_PUBLIC_SUPABASE_URL=http://localhost:54399 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=e2e next build && playwright test",
    "audit": "npm audit --audit-level=low",
    "seo:check": "node --experimental-transform-types --no-warnings scripts/check-seo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@supabase/supabase-js": "2.50.0",
    "mammoth": "1.13.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    },
    "postcss": "8.5.31",
    "sharp": "0.35.5"
  }
}
